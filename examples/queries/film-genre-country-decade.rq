SELECT ?genreLabel ?countryLabel ?decade (COUNT(?film) AS ?count)
WHERE {
  ?film wdt:P31 wd:Q11424 ;
        wdt:P136 ?genre ;
        wdt:P495 ?country ;
        wdt:P577 ?releaseDate .

  BIND(FLOOR(YEAR(?releaseDate) / 10) * 10 AS ?decade)

  VALUES ?genre {
    wd:Q130232   # drama
    wd:Q157443   # comedy
    wd:Q188473   # action film
    wd:Q2484376  # thriller
    wd:Q200092   # horror film
  }

  FILTER(?decade >= 1980 && ?decade <= 2020)

  SERVICE wikibase:label {
    bd:serviceParam wikibase:language "en".
  }
}
GROUP BY ?genreLabel ?countryLabel ?decade
LIMIT 300