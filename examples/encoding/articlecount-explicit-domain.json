{
  "name": "Article Count (Explicit Domain)",
  "description": "Uses explicit scale.domain [min, max] and automatic quartile binning for both color and size.",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "../queries/felidae-species-family-article-count.rq",
  "encoding": {
    "nodes": {
      "field": ["species", "family"],
      "color": {
        "field": "articleCount",
        "value": "#cccccc",
        "scale": {
          "type": "linear",
          "domain": [40, 220],
          "range": "Blues",
          "binning": {
            "method": "quartiles",
            "bins": 5
          }
        },
        "legend": { "title": "Article Count (Domain 40-220)", "position": "bottom", "display": true }
      },
      "size": {
        "field": "articleCount",
        "value": 7,
        "scale": {
          "type": "sqrt",
          "domain": [40, 220],
          "range": [4, 20],
          "binning": {
            "method": "quartiles",
            "bins": 5
          }
        },
        "legend": { "title": "Node Size (Domain 40-220)", "position": "bottom", "display": true }
      }
    },
    "links": {
      "field": { "source": "species", "target": "family" },
      "color": { "value": "#999" }
    }
  }
}
