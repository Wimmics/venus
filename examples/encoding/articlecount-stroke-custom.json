{
  "name": "Article Count with Custom Node Stroke",
  "description": "Tests nodes.stroke by applying a visible dark stroke color around nodes while keeping articleCount color/size quartiles.",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "../queries/felidae-species-family-article-count.rq",
  "encoding": {
    "nodes": {
      "field": ["species", "family"],
      "labels": { "display": true },
      "stroke": { "value": "black", "width": 2, "display": true },
      "color": {
        "field": "articleCount",
        "value": "#bdbdbd",
        "scale": {
          "type": "linear",
          "range": "Blues",
          "binning": { "method": "quartiles", "bins": 5 }
        },
        "legend": { "title": "Article Count (Color)" }
      },
      "size": {
        "field": "articleCount",
        "value": 7,
        "scale": {
          "type": "sqrt",
          "range": [4, 20],
          "binning": { "method": "quartiles", "bins": 5 }
        },
        "legend": { "title": "Article Count (Size)", "position": "top-left", "display": true }
      }
    },
    "links": {
      "field": { "source": "species", "target": "family" },
      "color": { "value": "#999" }
    }
  }
}
