{
    "name": "Robert Redford Co-Stars colored by Birth Year",
    "description": "Graph of co-stars of Robert Redford, with node size encoding the number of joint movies and color encoding the actor's birth year.",
    "endpoint": "https://dbpedia.org/sparql",
    "queryPath": "../queries/redford-costars-birthyear.rq",
    "encoding": {
        "interactions": {
            "tooltip": {"fields": ["actorBirthYear", "links"]}
        },
        "nodes": {
            "field": "actorName",
            "color": {
                "field": "actorBirthYear",
                "value": "#cccccc",
                "scale": {
                    "type": "quantitative",
                    "range": "Blues"
                },
                "legend": {
                    "title": "Actor's Birth Year",
                    "position": "top-left"
                }
            },
            "size": {
                "field": "links",
                "scale": {
                    "type": "linear",
                    "range": [5, 25]
                },
                "legend": {
                    "title": "Co-star Count",
                    "position": "top-left"
                }
            }
        },
        "links": {
            "field": "movieName"
        }
    }
}
