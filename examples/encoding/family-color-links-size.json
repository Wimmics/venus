{
  "name": "Family Color + Link Count Size",
  "description": "Colors by family label and sizes nodes by computed link degree to test topology-driven sizing.",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "../queries/felidae-species-family-basic.rq",
  "encoding": {
    "nodes": {
      "field": ["species", "family"],
      "color": {
        "field": "familyLabel",
        "value": "#cccccc",
        "scale": { "type": "ordinal", "range": "Set2" },
        "legend": { "title": "Family Label", "position": "left", "display": true }
      },
      "size": {
        "field": "links",
        "value": 6,
        "scale": { "type": "linear", "range": [4, 14] },
        "legend": { "title": "Node Degree", "position": "right", "display": true }
      }
    },
    "links": {
      "field": { "source": "species", "target": "family" },
      "color": { "value": "#999" }
    }
  }
}
