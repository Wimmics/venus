{
  "name": "Link Color by Species Count",
  "description": "Builds genus->family links and colors links by the number of species in each genus (speciesCount).",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "./test/queries/felidae-genus-family-speciescount.rq",
  "encoding": {
    "nodes": {
      "field": ["genus", "family"],
      "color": {
        "field": "genusLabel",
        "value": "#cccccc",
        "scale": { "type": "ordinal", "range": "Set3" },
        "legend": { "title": "Genus", "position": "left", "display": true }
      },
      "size": {
        "field": "links",
        "value": 7,
        "scale": { "type": "sqrt", "range": [5, 16] },
        "legend": { "title": "Node Degree", "position": "right", "display": true }
      }
    },
    "links": {
      "field": { "source": "genus", "target": "family" },
      "color": {
        "field": "speciesCount",
        "value": "#999",
        "scale": {
          "type": "linear",
          "range": "Blues",
          "binning": { "method": "quartiles", "bins": 5 }
        },
        "legend": { "title": "Species Count per Link", "position": "bottom", "display": true }
      }
    }
  }
}
