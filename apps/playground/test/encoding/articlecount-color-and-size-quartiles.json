{
  "name": "Article Count Color + Size (Quartiles)",
  "description": "Applies quantitative binning to both color and size using articleCount with the ColorBrewer Blues palette.",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "./test/queries/felidae-species-family-article-count.rq",
  "encoding": {
    "nodes": {
      "field": ["species", "family"],
      "color": {
        "field": "articleCount",
        "value": "#bdbdbd",
        "scale": {
          "type": "linear",
          "range": "Blues",
          "binning": { "method": "quartiles", "bins": 5 }
        },
        "legend": { "title": "Article Count (Color)"}
      },
      "size": {
        "field": "articleCount",
        "value": 7,
        "scale": {
          "type": "sqrt",
          "range": [4, 20],
          "binning": { "method": "quartiles", "bins": 5 }
        },
        "legend": { "title": "Article Count (Size)", "position": "top-left", "display": true }
      }
    },
    "links": {
      "field": { "source": "species", "target": "family" },
      "color": { "value": "#999" }
    }
  }
}
