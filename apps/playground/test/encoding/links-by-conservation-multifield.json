{
  "name": "Co-occurrence by IUCN (Species + Family Nodes)",
  "description": "Builds co-occurrence links using links.field=iucnLabel across all values in nodes.field (species and family).",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "./test/queries/felidae-species-family-conservation.rq",
  "encoding": {
    "nodes": {
      "field": ["species", "family"],
      "color": {
        "field": "iucnLabel",
        "value": "#cccccc",
        "scale": { "type": "ordinal", "range": "Set1" },
        "legend": { "title": "IUCN Status", "position": "bottom", "display": true }
      },
      "size": {
        "field": "links",
        "value": 8,
        "scale": { "type": "linear", "range": [6, 12] },
        "legend": { "title": "Node Degree", "position": "bottom", "display": true }
      }
    },
    "links": {
      "field": "iucnLabel",
      "color": { "value": "#999" }
    }
  }
}
