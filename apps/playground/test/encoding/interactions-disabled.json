{
  "name": "Interactions Disabled",
  "description": "Disables drag-and-drop and zoom/pan using encoding.interactions.",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "./test/queries/felidae-species-family-basic.rq",
  "encoding": {
    "interactions": {
      "drag": false,
      "zoom": false
    },
    "nodes": {
      "field": ["species", "family"],
      "color": {
        "field": "speciesLabel",
        "value": "#cccccc",
        "scale": { "type": "ordinal", "range": "Set3" },
        "legend": { "title": "Species", "position": "left", "display": true }
      },
      "size": {
        "field": "links",
        "value": 8,
        "scale": { "type": "linear", "range": [6, 12] },
        "legend": { "title": "Node Degree", "position": "right", "display": true }
      }
    },
    "links": {
      "field": { "source": "species", "target": "family" },
      "color": { "value": "#999" }
    }
  }
}
