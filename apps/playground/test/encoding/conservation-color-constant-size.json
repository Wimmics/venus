{
  "name": "Conservation Status Color",
  "description": "Tests sparse optional labels by coloring species with IUCN conservation status while keeping a constant node radius.",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "./test/queries/felidae-species-family-conservation.rq",
  "encoding": {
    "nodes": {
      "field": ["species", "family"],
      "color": {
        "field": "iucnLabel",
        "value": "#cccccc",
        "scale": { "type": "ordinal", "range": "Set1" },
        "legend": { "title": "IUCN Status", "position": "left", "display": true }
      },
      "size": {
        "field": "links",
        "value": 8,
        "scale": { "type": "linear", "range": [6, 12] },
        "legend": { "title": "Node Degree", "position": "right", "display": true }
      }
    },
    "links": {
      "field": { "source": "species", "target": "family" },
      "color": { "value": "#999" }
    }
  }
}
