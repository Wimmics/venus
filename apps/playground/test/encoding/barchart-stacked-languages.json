{
  "name": "Bar Chart: Official Languages (Stacked)",
  "description": "Tests bar-chart stack option with grouped categories by country and stacked segments by language. Set stack to true, false, or \"normalize\".",
  "visType": "bar-chart",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "./test/queries/countries-official-languages-count.rq",
  "encoding": {
    "stack": true,
    "x": {
      "field": "name",
      "axis": {
        "labelAngle": -90,
        "labelOffset": { "x": -6, "y": 12 }
      }
    },
    "y": {
      "field": "languageCount",
      "axis": {
        "tickFormat": "integer",
        "tickStep": 1,
        "labelOffset": { "x": -4, "y": 0 }
      },
      "scale": {
        "type": "count"
      }
    },
    "color": {
      "field": "langLabel",
      "value": "#cccccc",
      "scale": {
        "type": "ordinal",
        "range": "Set3"
      },
      "legend": {
        "title": "Official Language",
        "position": "top-right",
        "display": true
      }
    },
    "direction": "vertical"
  }
}
