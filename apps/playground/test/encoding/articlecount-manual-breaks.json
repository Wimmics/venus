{
  "name": "Article Count (Manual Breaks)",
  "description": "Uses explicit binning.breaks thresholds for both color and size, with automatic domain extent from data.",
  "endpoint": "https://query.wikidata.org/sparql",
  "queryPath": "./test/queries/felidae-species-family-article-count.rq",
  "encoding": {
    "nodes": {
      "field": ["species", "family"],
      "color": {
        "field": "articleCount",
        "value": "#cccccc",
        "scale": {
          "type": "linear",
          "range": "Blues",
          "binning": {
            "breaks": [60, 90, 130, 190]
          }
        },
        "legend": { "title": "Article Count (Manual Breaks)", "position": "bottom", "display": true }
      },
      "size": {
        "field": "articleCount",
        "value": 7,
        "scale": {
          "type": "sqrt",
          "range": [4, 20],
          "binning": {
            "breaks": [60, 90, 130, 190]
          }
        },
        "legend": { "title": "Node Size (Manual Breaks)", "position": "bottom", "display": true }
      }
    },
    "links": {
      "field": { "source": "species", "target": "family" },
      "color": { "value": "#999" }
    }
  }
}
