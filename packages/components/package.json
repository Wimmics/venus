{
  "name": "@wimmics/venus-elements",
  "version": "1.0.3",
  "description": "Web Components for SPARQL/D3 visualizations",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": true,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rollup -c",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "dependencies": {
    "d3": "^7.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",

    "@wimmics/venus-core": "file:../core",
    "@wimmics/venus-d3renderer": "file:../renderer-d3",
    "@wimmics/venus-encoding": "file:../encoding",
    "@wimmics/venus-mappers": "file:../mappers",
    "@wimmics/venus-sparql": "file:../sparql",
    "@wimmics/venus-datasource": "file:../datasource",
    "@wimmics/venus-legends": "file:../legends",
    
    "rollup": "^4.0.0",
    "rollup-plugin-string": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "knowledge-graph",
    "visualization",
    "web-components",
    "sparql",
    "semantic-web"
  ]
}
