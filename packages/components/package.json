{
  "name": "@wimmics/kgnovis-webcomponents",
  "version": "0.1.0",
  "description": "Web Components for SPARQL/D3 visualizations",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md", "LICENSE"],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rollup -c",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "d3": "^7.0.0"
  },
  "devDependencies": {
    "@org/core": "file:../core",
    "@org/encoding": "file:../encoding",
    "@org/datasource-sparql": "file:../datasource-sparql",
    "@org/renderer-d3": "file:../renderer-d3",

    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "rollup": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
