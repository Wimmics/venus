{
  "name": "@wimmics/kgnovis-webcomponents",
  "version": "0.1.0",
  "description": "Web Components for SPARQL/D3 visualizations",
  "type": "module",
  "exports": {
    ".": {
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rm -rf dist",
    "build": "rollup -c",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "peerDependencies": {
    "d3": "^7.0.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.0",
    "@rollup/plugin-node-resolve": "^15.0.0",
    "@rollup/plugin-terser": "^0.4.0",
    "@wimmics/kgnovis-core": "file:../core",
    "@wimmics/kgnovis-d3renderer": "file:../renderer-d3",
    "@wimmics/kgnovis-encoding": "file:../encoding",
    "@wimmics/kgnovis-mappers": "file:../mappers",
    "@wimmics/kgnovis-sparql": "file:../sparql",
    "rollup": "^4.0.0",
    "rollup-plugin-string": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
